# ── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ── Database ──────────────────────────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USERNAME=postgres
PG_PASSWORD=postgres
PG_DATABASE=patient_portal_dev

# ── Video Sessions ─────────────────────────────────────────────────────────────
# Secret used to sign video-session JWT tokens issued to patients/providers.
# This is NOT the auth JWT secret — the API gateway owns auth token validation.
VIDEO_SESSION_SECRET=change-me-in-production
VIDEO_SESSION_EXPIRY_MINUTES=90

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# ── API Gateway ────────────────────────────────────────────────────────────────
# Optional: when set, displayed as a server entry in Swagger UI.
# The gateway is responsible for JWT signature validation before forwarding
# requests to this service.
# GATEWAY_BASE_URL=https://your-gateway.example.com

# ── Tenant / Extension ────────────────────────────────────────────────────────
TENANT_NAME=telehealth
EXTENSION_NAME=telehealth-booking-and-consultation
